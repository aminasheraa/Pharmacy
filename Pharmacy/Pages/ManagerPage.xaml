<Page x:Class="Pharmacy.Pages.ManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ManagerPage"  Style="{DynamicResource PageBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0" VerticalAlignment="Center">
            <TextBlock Text="Пользователь" x:Name="ManagerName"  Style="{StaticResource HeaderText}" VerticalAlignment="Center" Margin="20" FontWeight="Bold"/>
            <Button x:Name="ExitBtn" Content="Выход" Background="#CD5C5C"  Click="ExitBtn_Click"  Margin="10" Width="100" ToolTip="Выход из аккаунта"/>

        </StackPanel>

        <ListBox x:Name="PharmaciesLB" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent" d:ItemsSource="{d:SampleData ItemCount=5}" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource MainBorder}" Width="710" HorizontalAlignment="Center"  VerticalAlignment="Center" BorderThickness="1" CornerRadius="8" Padding="20">

                        <StackPanel Orientation="Horizontal">
                            <StackPanel Orientation="Vertical">
                                <TextBlock x:Name="PharmacyID" Text="{Binding ID, StringFormat=Аптека № {0}}" FontWeight="Bold" Margin="5" ToolTip="ФИО пользователя"/>
                                <TextBlock x:Name="Address" Text="{Binding Address, StringFormat=Адрес: {0}}" Margin="5" ToolTip="Логин пользователя" FontSize="14"/>
                                
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="10">
                                <Button x:Name="OrderBtn" Content="Заказать поставку" Width="160" Margin="5" Click="OrderBtn_Click"  ToolTip="Заказ поставки товаров в аптеку"/>
                                <Button x:Name="InventoryBtn" Content="Инвентаризация" Margin="5"   Width="160"  Click="InventoryBtn_Click"  ToolTip="Провести инвентаризацию аптеки"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel>

                    </WrapPanel>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
