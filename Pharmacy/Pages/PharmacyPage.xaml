<Page x:Class="Pharmacy.Pages.PharmacyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PharmacyPage" Style="{DynamicResource PageBackground}">

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="377*"/>
                <RowDefinition Height="73*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Наличие товаров в аптеке: " Style="{StaticResource HeaderText}"  HorizontalAlignment="Left" Margin="70, 10, 0, 0"/>
            <DataGrid x:Name="DataGridProducts" Width="650" Height="250"
                      Style="{StaticResource MainDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                      RowStyle="{StaticResource DataGridRowStyle}"
                      CellStyle="{StaticResource DataGridCellStyle}"
                      ItemsSource="{Binding}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название товара"
                                        Binding="{Binding Products.Name}"
                                        Width="*"/>

                        <DataGridTextColumn Header="Цена"
                                        Binding="{Binding Products.Price, StringFormat={}{0:F2} руб.}"
                                        Width="120"/>

                        <DataGridTextColumn Header="Количество"
                                        Binding="{Binding Count}"
                                        Width="120"/>

                        <DataGridTextColumn Header="Сумма"
                                        Binding="{Binding TotalSum, StringFormat={}{0:F2} руб.}"
                                        Width="150"/>
                    </DataGrid.Columns>

                </DataGrid>
            
                <Button Grid.Row="1" x:Name="ButtonAdd" ToolTip="Добавить данные"
    Content="Добавить" HorizontalAlignment="Left" Click="ButtonAdd_Click"/>
                <Button Grid.Row="1" x:Name="ButtonDel" ToolTip="Удалить данные"
    Content="Удалить" HorizontalAlignment="Right" Click="ButtonDel_Click"/>
        </Grid>
    </Grid>
</Page>
