<Page x:Class="Pharmacy.Pages.DiagramPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DiagramPage" Style="{DynamicResource PageBackground}"> 

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Диаграмма остатков товаров" Style="{DynamicResource HeaderText}" Margin="0,0,0,15" />
                <Button x:Name="BackBtn" Content="Назад" Width="90" Margin="20,3,0,0" Click="BackBtn_Click" Height="25" VerticalAlignment="Top"/>
            </StackPanel>
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Аптека:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PharmacyCB" Width="220" Height="32" Margin="0,0,20,8" DisplayMemberPath="Address" SelectionChanged="UpdateChart"/>
                <TextBlock Text="Тип диаграммы:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="DiagramCB" Width="180" Height="32" Margin="0,0,0,8" SelectionChanged="UpdateChart"/>
            </WrapPanel>
        </StackPanel>

        <Border Grid.Row="1">
            <WindowsFormsHost x:Name="ChartHost"/>
        </Border>
    </Grid>
</Page>
