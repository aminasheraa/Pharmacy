<Page x:Class="Pharmacy.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" Style="{DynamicResource PageBackground}">

    <Grid>
        <Border Style="{DynamicResource MainBorder}" Width="210" HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
                <TextBlock Text="Авторизация" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                <TextBlock Text="Логин: " Margin="5"/>
                <TextBox x:Name="LoginTB" Height="30" Width="150" Margin="5"/>
                <TextBlock Text="Пароль: " Margin="5"/>
                <PasswordBox x:Name="PB" Height="30" Width="150" Margin="5"/>
                <Button x:Name="AuthBtn" Content="Войти" Height="30" Width="150" Margin="5,15,5,5" Click="AuthBtn_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
