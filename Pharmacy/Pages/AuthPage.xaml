<Page x:Class="Pharmacy.Pages.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Pharmacy.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Авторизация"/>
            <TextBlock Text="Логин: " Margin="5"/>
            <TextBox x:Name="LoginTB" Height="30" Width="120" Margin="5"/>
            <TextBlock Text="Пароль: " Margin="5"/>
            <PasswordBox x:Name="PB" Height="30" Width="120" Margin="5"/>
            <Button x:Name="AuthBtn" Content="Войти" Height="30" Width="120" Click="AuthBtn_Click"/>
        </StackPanel>
        
    </Grid>
</Page>
