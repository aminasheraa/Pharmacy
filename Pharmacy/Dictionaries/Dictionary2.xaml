<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="17"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="33"/>

    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Book Antiqua"/>

    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="33"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="35"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MaxWidth" Value="300"/>
        <Setter Property="Background" Value="#5C9EA5"/>
    </Style>


    <Style TargetType="Border" x:Key="MainBorder">
        <Setter Property="BorderBrush" Value="#AFEEEE"/>
        <Setter Property="BorderBrush" Value="#29467F"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#B0E0E6"/>
        <Setter Property="Margin" Value="20"/>
    </Style>

    <Style TargetType="Page" x:Key="PageBackground">
        <Setter Property="Background" Value="#F0FFFF"/>
    </Style>

    <Style TargetType="Window">
        <Setter Property="Background" Value="#F0FFFF"/>
    </Style>


    <Style x:Key="PlaceholderTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="33"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!-- Основная рамка текстового поля -->
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" 
                        SnapsToDevicePixels="True">
                            <!-- Область, где отображается вводимый текст -->
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>

                        <!-- Плейсхолдер. Скрыт по умолчанию -->
                        <TextBlock x:Name="placeholderText" 
                           Text="{TemplateBinding Tag}" 
                           Foreground="Gray" 
                           IsHitTestVisible="False" 
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                           Margin="{TemplateBinding Padding}"
                           Visibility="Collapsed"/>
                    </Grid>

                    <!-- Рабочие триггеры WPF -->
                    <ControlTemplate.Triggers>
                        <!-- 1. Если текст пустой — показываем подсказку -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Visible"/>
                        </Trigger>

                        <!-- 2. Если пользователь кликнул в поле (фокус) — скрываем подсказку -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlaceholderPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="border" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <TextBlock x:Name="placeholderText" Text="{TemplateBinding Tag}" Foreground="Gray" IsHitTestVisible="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" Visibility="Visible"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="placeholderText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MainDataGridStyle" TargetType="DataGrid">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Background" Value="#F0FFFF"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#29467F"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="RowBackground" Value="#FFFFFF"/>
        <Setter Property="AlternatingRowBackground" Value="#E0F7FA"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#AFEEEE"/>
        <Setter Property="VerticalGridLinesBrush" Value="#AFEEEE"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="CanUserResizeRows" Value="False"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeaderWidth" Value="0"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="SelectionMode" Value="Single"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="DataGridHeaderStyle"
           TargetType="DataGridColumnHeader">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Background" Value="#5C9EA5"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="BorderBrush" Value="#29467F"/>
        <Setter Property="BorderThickness" Value="0,0,1,1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="DataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="35"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B0E0E6"/>
            </Trigger>

            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#5C9EA5"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#5C9EA5"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>