<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="17"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="33"/>

    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="FontFamily" Value="Book Antiqua"/>

    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="33"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Book Antiqua"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Height" Value="35"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="Width" Value="200"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MaxWidth" Value="300"/>
        <Setter Property="Background" Value="#d0bcfc"/>
    </Style>

    <Style TargetType="Button" x:Key="NegativeBtn">
        <Setter Property="FontFamily" Value="Open Sans"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="MaxWidth" Value="300"/>
        <Setter Property="Background" Value="#DD4B42"/>
    </Style>


    <Style TargetType="Border" x:Key="MainBorder">
        <Setter Property="BorderBrush" Value="#9370DB"/>
        <Setter Property="BorderBrush" Value="#5732A8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="#ede3fc"/>
        <Setter Property="Margin" Value="20"/>
    </Style>

    <Style TargetType="Page" x:Key="PageBackground">
        <Setter Property="Background" Value="#fdfdc9"/>
    </Style>

    <Style TargetType="Window" x:Key="WindowBackground">
        <Setter Property="Background" Value="#fdfdc9"/>
    </Style>


</ResourceDictionary>




